# Copy to .env and fill in. Never commit .env — only this file.
#
#   cp .env.example .env

# --- OpenRouter -------------------------------------------------------------
# The key we sent you. Same key for your coding assistant and for the models
# inside your solution. Hard cap of $10.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Models -----------------------------------------------------------------
# Model names belong here, not in your code — we will swap them when we run it.
# Any model on OpenRouter is fair game; pick ones that handle French well.
CHAT_MODEL=
CHAT_FALLBACK_MODEL=
EMBEDDING_MODEL=

# --- Your FastAPI service ---------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000

# --- Langfuse (bonus, optional) ---------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database -----------------------------------------------------------------
DATABASE_URL=sqlite:///./neova.db

# --- Demo clock (opt-in only; fixture slots are in Aug/Sep 2026) --------------
# To use the supplied fixture slots later, set CLOCK_MODE=frozen and
# DEMO_TIMESTAMP=2026-08-26T12:00:00+02:00 (Europe/Paris).
CLOCK_MODE=live
DEMO_TIMESTAMP=

# Sessions are random, server-issued, process-local tokens. No signing key
# is required for foundation mode; this is not real authentication.
