# Copy to .env and fill in. Never commit .env — only this file.
#
#   cp .env.example .env

# --- OpenRouter -------------------------------------------------------------
# Supplied key only, shared with the coding assistant. Leave blank for a
# keyless local API + FTS5 demo; check remaining cap before live calls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Models -----------------------------------------------------------------
# Model names belong here, not in your code — we will swap them when we run it.
# Choose French-capable routes and verify them against the supplied key.
# Previous live classifier openai/gpt-4.1-nano returned 404 with strict
# parameter routing; the fallback and embedding route remain unverified.
# Keyless startup builds public FTS5 only. Explicit `python -m neova.retrieval
# index` builds vectors when the budget gate allows it.
CLASSIFIER_MODEL=
CHAT_MODEL=
CHAT_FALLBACK_MODEL=
EMBEDDING_MODEL=

# --- Your FastAPI service ---------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000

# --- Usage evidence (optional) -----------------------------------------------
# Append-only redacted per-call usage log (model, provider, tokens, cost).
# Empty = memory only (evidence disappears with the process). Read it back:
#   python -m neova.usage path/to/usage.jsonl
USAGE_LOG=

# --- Langfuse tracing (bonus, optional) -------------------------------------
# Set both keys to enable tracing: one Langfuse trace per /agent/chat turn
# (root observation named "agent-chat", grouped per demo session; chat and
# classifier calls are captured as generations with model/token usage).
# Empty = tracing off (no client, no network traffic). Read-only elsewhere:
#   LANGFUSE_HOST also accepts LANGFUSE_BASE_URL. Optional, for clean
#   dashboards (keeps dev traces out of production views):
#   LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database -----------------------------------------------------------------
DATABASE_URL=sqlite:///./neova.db

# --- Demo clock (opt-in only; fixture slots are in Aug/Sep 2026) --------------
# To use the supplied fixture slots later, set CLOCK_MODE=frozen and
# DEMO_TIMESTAMP=2026-08-26T12:00:00+02:00 (Europe/Paris).
# In live time after September 2026, supplied slots are past and unbookable.
CLOCK_MODE=live
DEMO_TIMESTAMP=

# Sessions are random, server-issued, process-local tokens. No signing key
# is required for foundation mode; this is not real authentication.
